}

### Login User A

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailA}}",
    "password": "{{passwordA}}"
}

### Login User B

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "{{emailB}}",
    "password": "{{passwordB}}"
}

### Logout ("refreshToken": "{{accessTokenA}}")

POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
	"refreshToken": "{{accessTokenA}}"
}

### Authentication — Valid Access Token (First, log in then copy the returned access token.)

GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessTokenA}}

### Update Account profile

PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{accessTokenB}}
Content-Type: application/json

{
    "firstName": "Account",
    "lastName": "Tester",
    "phone": "+254712345678"
}

### Attempt to update a protected field

PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{accessTokenB}}
Content-Type: application/json

{
    "firstName": "Account",
    "role": "admin"
}

### sessions

GET {{baseUrl}}/auth/sessions
Authorization: Bearer {{accessTokenA}}
Content-Type: application/json

### revoke/ delete 1 of User A's sessions

DELETE {{baseUrl}}/auth/sessions/{{sessionId}}
Authorization: Bearer {{accessTokenA}}
Content-Type: application/json

### Revoke other User A's sessions

DELETE {{baseUrl}}/auth/sessions
Authorization: Bearer {{accessTokenA}}
Content-Type: application/json

### Successful Refresh ("refreshToken": "<refresh_token_from_login_response>"), then Reuse the Old Refresh Token

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{refreshTokenA}}"
}