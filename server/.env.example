NODE_ENV=development
PORT=5000

# Maximum accepted JSON request body
REQUEST_BODY_LIMIT=64kb
# Ideation generation rate limit, two requests per minute
IDEATION_GENERATION_RATE_LIMIT_MAX=2
IDEATION_GENERATION_RATE_LIMIT_WINDOW_MS=600000
# Ideation retrieval rate limit, two requests per minute
IDEATION_RETRIEVAL_RATE_LIMIT_MAX=2
IDEATION_RETRIEVAL_RATE_LIMIT_WINDOW_MS=600000

MONGODB_URI=<your-mongodb-connection-string>

CLIENT_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
